# ──────────────────────────────────────────────────────────────────────────────
# RepuTE Frontend — Environment Variables
#
# Copy this file to .env and fill in your values before running `npm start`.
# Never commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# Soroban smart contract address (Stellar Testnet)
# Default is the deployed RepuTE contract. Replace with your own if you redeploy.
REACT_APP_CONTRACT_ID=CB424V2KWLZ4EXHLQQR4P63KR4RWKVE7S4UM2QUWT2P2RHDLLFSZWVDH

# Stellar network to connect to: TESTNET or PUBLIC
REACT_APP_STELLAR_NETWORK=TESTNET

# Horizon REST API endpoint
REACT_APP_HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC endpoint
REACT_APP_RPC_URL=https://soroban-testnet.stellar.org
